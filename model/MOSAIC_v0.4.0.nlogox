        <metric>reward-gini</metric>
        <metric>contract-gini</metric>
        <metric>top-reward-share</metric>
        <metric>count communication-links</metric>
        <metric>mean-network-degree</metric>
        <metric>current-network-density</metric>
        <metric>count robots with [not any? my-communication-links]</metric>
        <metric>information-transmissions</metric>
        <metric>unique-information-acquisitions</metric>
        <metric>information-coverage</metric>
        <metric>information-redundancy-ratio</metric>
        <metric>mean-reputation</metric>
        <metric>min [reputation] of robots</metric>
        <metric>max [reputation] of robots</metric>
        <metric>count robots with [strategy = "competitive"]</metric>
        <metric>count robots with [strategy = "cooperative"]</metric>
        <metric>count robots with [strategy = "balanced"]</metric>
        <metric>strategy-switches-total</metric>
        <metric>coordination-overhead</metric>
        <metric>mission-coordination-efficiency</metric>
        <metric>sum [energy-used] of robots</metric>
        <metric>sum [energy] of robots</metric>
