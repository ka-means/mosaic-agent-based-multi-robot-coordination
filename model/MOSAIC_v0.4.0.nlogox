    <experiment name="BS06_Reputation_Adaptation_30_Seeds" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="500">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition><![CDATA[not any? tasks with [not completed? and not failed?]
or ticks >= mission-time-limit
or not any? robots with [energy > 0]]]></exitCondition>
      <metrics>
        <metric>ticks</metric>
        <metric>count tasks with [completed?]</metric>
        <metric>count tasks with [failed?]</metric>
        <metric>completion-rate</metric>
        <metric>discovered-task-completion-rate</metric>
        <metric>explored-area-percentage</metric>
        <metric>count tasks with [not cooperative?]</metric>
        <metric>count tasks with [cooperative?]</metric>
        <metric>count tasks with [cooperative? and completed?]</metric>
        <metric>total-bids</metric>
        <metric>contested-auction-rounds</metric>
        <metric>unresolved-auction-rounds</metric>
        <metric>total-contracts-awarded</metric>
        <metric>total-contract-memberships-awarded</metric>
        <metric>total-contract-releases</metric>
        <metric>coalition-formation-attempts</metric>
        <metric>coalitions-formed</metric>
        <metric>coalition-tasks-completed</metric>
        <metric>coalition-success-rate</metric>
        <metric>coalition-efficiency</metric>
        <metric>mean-coalition-size</metric>
        <metric>mean-coalition-formation-delay</metric>
        <metric>total-task-value</metric>
        <metric>total-rewards-distributed</metric>
        <metric>total-mission-bonuses</metric>
        <metric>reward-gini</metric>
        <metric>contract-gini</metric>
        <metric>top-reward-share</metric>
        <metric>count communication-links</metric>
        <metric>mean-network-degree</metric>
        <metric>current-network-density</metric>
        <metric>count robots with [not any? my-communication-links]</metric>
        <metric>information-transmissions</metric>
        <metric>unique-information-acquisitions</metric>
        <metric>information-coverage</metric>
        <metric>information-redundancy-ratio</metric>
        <metric>mean-reputation</metric>
        <metric>min [reputation] of robots</metric>
        <metric>max [reputation] of robots</metric>
        <metric>count robots with [strategy = "competitive"]</metric>
        <metric>count robots with [strategy = "cooperative"]</metric>
        <metric>count robots with [strategy = "balanced"]</metric>
        <metric>strategy-switches-total</metric>
        <metric>coordination-overhead</metric>
        <metric>mission-coordination-efficiency</metric>
        <metric>sum [energy-used] of robots</metric>
        <metric>sum [energy] of robots</metric>
        <metric>count tasks with [failed? and failure-reason = "undiscovered"]</metric>
        <metric>count tasks with [failed? and member? failure-reason (list "no-feasible-bid" "no-feasible-coalition" "auction-unresolved")]</metric>
        <metric>count tasks with [failed? and member? failure-reason (list "deadline-after-assignment" "coalition-deadline-after-assignment")]</metric>
        <metric>count tasks with [failed? and failure-reason != "undiscovered" and not member? failure-reason (list "no-feasible-bid" "no-feasible-coalition" "auction-unresolved" "deadline-after-assignment" "coalition-deadline-after-assignment")]</metric>
        <metric>all? tasks [not (completed? and failed?)]</metric>
        <metric>abs ((sum [starting-energy] of robots) - (sum [energy-used] of robots) - (sum [energy] of robots))</metric>
        <metric>abs ((sum [credits] of robots) - total-rewards-distributed)</metric>
        <metric><![CDATA[all? robots [reputation >= 0 and reputation <= 1]]]></metric>
        <metric>all? robots [member? strategy (list "competitive" "cooperative" "balanced")]</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="random-seed-value" first="1" step="1" last="30"></steppedValueSet>
        <enumeratedValueSet variable="terrain-heterogeneity">
          <value value="0.5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="hazard-intensity">
          <value value="0.5"></value>
