<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[; =============================================================================
; MOSAIC
; Mission-Oriented Self-Organization through Auctions, Incentives,
; and Coalitions
;
; Version: 0.4.0
; Developers and Model Authors: Katherin Molina and Lorena Holguin
; Copyright (c) 2026 Katherin Molina and Lorena Holguin
; SPDX-License-Identifier: Apache-2.0
; Licensed under the Apache License, Version 2.0.
; See LICENSE-CODE in the repository root.
; =============================================================================
; Layer 1: Synthetic heterogeneous environment
; Layer 2: Heterogeneous robot agents
; Layer 3: Exploration, movement costs, hazards, and energy consumption
; Layer 4: Heterogeneous mission tasks and partial discovery
; Layer 5: Dynamic communication network and local information sharing
; Layer 6: Decentralized bidding, competition, and individual task execution
; Layer 7: Cooperative tasks, coalition formation, and reward-sharing incentives
; Layer 7.1: Contract robustness and coordination diagnostics
; Layer 8: Reputation and contract reliability
; Layer 9: Adaptive strategy selection
; Layer 10: Advanced complex-systems metrics and verification
; =============================================================================


globals [
  model-version

  information-transmissions
  unique-information-acquisitions

  total-bids
  contested-auction-rounds
  unresolved-auction-rounds
  total-contracts-awarded
  total-contract-memberships-awarded

  coalition-formation-attempts
  coalitions-formed
  coalition-release-events
  coalition-tasks-completed

  total-task-value
  total-rewards-distributed
  total-mission-bonuses

  total-contract-releases
  strategy-switches-total
  verification-last-result
]


breed [robots robot]
breed [tasks task]


undirected-link-breed [
  communication-links
  communication-link
]


robots-own [
  robot-id

  sensing-capability
  manipulation-capability
  transport-capability
  communication-capability

  speed
  energy
  starting-energy
  risk-tolerance

  state

  ; Local decentralized knowledge.
  known-task-ids
  next-known-task-ids

  ; Auction and contract variables.
  target-task-id
  current-bid
  current-contribution

  ; Economic and performance variables.
  credits
  last-payoff

  ; Reputation and contract reliability.
  reputation
  contract-successes
  contract-failures
  contract-release-events

  ; Adaptive strategy state.
  strategy
  competitive-value
  cooperative-value
  balanced-value
  strategy-period-payoff
  strategy-switches
  last-strategy-update

  contracts-won
  contracts-lost
  competition-events
  cooperation-events
  tasks-completed

  distance-travelled
  energy-used
]


tasks-own [
  task-id

  base-reward
  deadline
  service-duration
  risk-level

  cooperative?
  required-team-size

  required-sensing
  required-manipulation
  required-transport
  required-communication

  discovered?
  discovered-at
  discovered-by

  auction-status
  bid-list

  ; assigned-robot-id is the lead robot.
  assigned-robot-id
  assigned-robot-ids
  winning-bid
  assignment-tick
  formation-delay
  execution-start-tick
  total-waiting-ticks

  ever-received-bid?
  ever-assigned?
  failure-reason
  last-release-reason
  release-count

  work-progress

  completed?
  completed-at
  completed-by-robot-ids
  distributed-reward
  failed?
]


patches-own [
  terrain-cost
  hazard-level
  communication-quality
  visibility-level
  explored?
  patch-zone
]


communication-links-own [
  link-quality
]


; =============================================================================
; MAIN PROCEDURES
; =============================================================================

to setup

  clear-all

  random-seed random-seed-value

  set model-version "0.4.0"

  set information-transmissions 0
  set unique-information-acquisitions 0

  set total-bids 0
  set contested-auction-rounds 0
  set unresolved-auction-rounds 0
  set total-contracts-awarded 0
  set total-contract-memberships-awarded 0

  set coalition-formation-attempts 0
  set coalitions-formed 0
  set coalition-release-events 0
  set coalition-tasks-completed 0

  set total-task-value 0
  set total-rewards-distributed 0
  set total-mission-bonuses 0

  set total-contract-releases 0
  set strategy-switches-total 0
  set verification-last-result "NOT RUN"

  setup-environment
  setup-robots
  setup-tasks

  update-communication-network

  update-robot-appearance
  update-task-appearance

  reset-ticks

end


to go

  if ticks >= mission-time-limit [
    stop
  ]

  if not any? robots with [energy > 0] [
    stop
  ]

  update-task-deadlines

  if not any? tasks with [not completed? and not failed?] [
    update-robot-appearance
    update-task-appearance
    stop
  ]

  ; Robots either explore or move toward an existing contract.
  ask robots with [energy > 0] [

    ifelse target-task-id = -1 [
      perform-exploration-step
    ] [
      perform-contracted-step
    ]

    if energy > 0 [
      detect-nearby-tasks
    ]
  ]

  ; Communication depends on the robots' new positions.
  update-communication-network
  share-task-information

  ; Free robots bid only for tasks in their local knowledge.
  run-decentralized-auctions

  ; Task execution is updated once per task per tick.
  advance-active-tasks

  update-reputation-decay
  update-adaptive-strategies

  update-robot-appearance
  update-task-appearance

  tick

end


; =============================================================================
; ENVIRONMENT INITIALIZATION
; =============================================================================

to setup-environment

  ask patches [

    set terrain-cost
      (1 + terrain-heterogeneity * random-float 2)

    set hazard-level
      (hazard-intensity * random-float 1)

    set communication-quality
      (1 - terrain-heterogeneity * random-float 0.65)

    set visibility-level
      (1 - terrain-heterogeneity * random-float 0.55)

    set explored? false
    set patch-zone "open"
  ]

  repeat 4 [
    diffuse terrain-cost 0.35
    diffuse hazard-level 0.35
    diffuse communication-quality 0.35
    diffuse visibility-level 0.35
  ]

  ask patches [

    set terrain-cost
      (bounded-value terrain-cost 0.50 3)

    set hazard-level
      (bounded-value hazard-level 0 1)

    set communication-quality
      (bounded-value communication-quality 0.05 1)

    set visibility-level
      (bounded-value visibility-level 0.20 1)

    assign-patch-zone
  ]

end


to assign-patch-zone

  ifelse hazard-level > 0.62 [

    set patch-zone "hazard"
    set pcolor (scale-color red hazard-level 0 1)

  ] [

    ifelse communication-quality < 0.45 [

      set patch-zone "communication-shadow"
      set pcolor (scale-color blue communication-quality 0 1)

    ] [

      ifelse terrain-cost > 1.65 [

        set patch-zone "difficult-terrain"
        set pcolor (scale-color brown terrain-cost 0.50 3)

      ] [

        set patch-zone "open"
        set pcolor (scale-color green communication-quality 0 1)
      ]
    ]
  ]

end


; =============================================================================
; ROBOT INITIALIZATION
; =============================================================================

to setup-robots

  let suitable-patches patches with [hazard-level < 0.75]

  create-robots number-of-robots [

    ifelse any? suitable-patches [
      move-to one-of suitable-patches
    ] [
      move-to one-of patches
    ]

    set robot-id who
    set heading random-float 360

    set sensing-capability
      (bounded-value
        (0.50 + random-normal 0 (0.22 * capability-heterogeneity))
        0.10
        1)

    set manipulation-capability
      (bounded-value
        (0.50 + random-normal 0 (0.22 * capability-heterogeneity))
        0.10
        1)

    set transport-capability
      (bounded-value
        (0.50 + random-normal 0 (0.22 * capability-heterogeneity))
        0.10
        1)

    set communication-capability
      (bounded-value
        (0.50 + random-normal 0 (0.22 * capability-heterogeneity))
        0.10
        1)

    set speed
      (bounded-value
        (0.75 + random-normal 0 (0.20 * capability-heterogeneity))
        0.30
        1.20)

    set starting-energy
      (bounded-value
        (robot-initial-energy +
          random-normal
            0
            (robot-initial-energy * 0.25 * energy-heterogeneity))
        (robot-initial-energy * 0.50)
        (robot-initial-energy * 1.50))

    set energy starting-energy

    set risk-tolerance
      (bounded-value
        (0.50 + random-normal 0 (0.25 * capability-heterogeneity))
        0
        1)

    set state "exploring"

    set known-task-ids []
    set next-known-task-ids []

    set target-task-id -1
    set current-bid 0
    set current-contribution 0

    set credits 0
    set last-payoff 0

    set reputation 0.50
    set contract-successes 0
    set contract-failures 0
    set contract-release-events 0

    initialize-robot-strategy

    set contracts-won 0
    set contracts-lost 0
    set competition-events 0
    set cooperation-events 0
    set tasks-completed 0

    set distance-travelled 0
    set energy-used 0

    set shape "circle"
    set size (1.10 + 0.60 * communication-capability)

    set color blue
    set label (word "R" robot-id)
    set label-color white

    ask patch-here [
      set explored? true
    ]
  ]

end


; =============================================================================
; TASK INITIALIZATION
; =============================================================================

to setup-tasks

  let eligible-patches
    patches with [
      not any? robots-here and
      hazard-level < 0.95
    ]

  let tasks-to-create
    min (list number-of-tasks count eligible-patches)

  ask n-of tasks-to-create eligible-patches [

    sprout-tasks 1 [

      set task-id who

      set cooperative?
        (random-float 1 < coalition-task-proportion)

      ifelse cooperative? [

        set required-team-size
          (2 + random (maximum-coalition-size - 1))

      ] [

        set required-team-size 1
      ]

      let reward-multiplier
        ifelse-value cooperative?
          [coalition-reward-multiplier]
          [1]

      set base-reward
        (bounded-value
          ((base-task-reward * reward-multiplier) +
            random-normal
              0
              (base-task-reward * reward-multiplier *
                0.35 * task-reward-heterogeneity))
          (base-task-reward * reward-multiplier * 0.50)
          (base-task-reward * reward-multiplier * 1.50))

      set deadline
        round
          (bounded-value
            (task-deadline-base +
              random-normal
                0
                (task-deadline-base *
                  0.35 * task-deadline-heterogeneity))
            20
            mission-time-limit)

      let duration-multiplier
        ifelse-value cooperative?
          [1 + 0.25 * (required-team-size - 1)]
          [1]

      set service-duration
        max
          (list
            1
            round
              ((task-service-duration-base * duration-multiplier) +
                random-normal
                  0
                  (0.30 * task-service-duration-base)))

      set risk-level
        (bounded-value
          ((0.60 * [hazard-level] of patch-here) +
            (0.40 * random-float 1))
          0
          1)

      ifelse cooperative? [

        ; Cooperative tasks require aggregate capabilities.
        let requirement-centre
          (0.45 * required-team-size)

        set required-sensing
          (bounded-value
            (requirement-centre + random-normal 0 0.15)
            0.60
            required-team-size)

        set required-manipulation
          (bounded-value
            (requirement-centre + random-normal 0 0.15)
            0.60
            required-team-size)

        set required-transport
          (bounded-value
            (requirement-centre + random-normal 0 0.15)
            0.60
            required-team-size)

        set required-communication
          (bounded-value
            (requirement-centre + random-normal 0 0.15)
            0.60
            required-team-size)

      ] [

        set required-sensing
          (bounded-value (0.50 + random-normal 0 0.20) 0.10 1)

        set required-manipulation
          (bounded-value (0.50 + random-normal 0 0.20) 0.10 1)

        set required-transport
          (bounded-value (0.50 + random-normal 0 0.20) 0.10 1)

        set required-communication
          (bounded-value (0.50 + random-normal 0 0.20) 0.10 1)
      ]

      set discovered? false
      set discovered-at -1
      set discovered-by -1

      set auction-status "closed"
      set bid-list []

      set assigned-robot-id -1
      set assigned-robot-ids []
      set winning-bid 0
      set assignment-tick -1
      set formation-delay -1
      set execution-start-tick -1
      set total-waiting-ticks 0

      set ever-received-bid? false
      set ever-assigned? false
      set failure-reason "none"
      set last-release-reason "none"
      set release-count 0

      set work-progress 0

      set completed? false
      set completed-at -1
      set completed-by-robot-ids []
      set distributed-reward 0
      set failed? false

      set shape "target"
      set size
        (ifelse-value cooperative? [2.00] [1.60])

      set color yellow
      set hidden? true
      set label ""
      set label-color white
    ]
  ]

end


; =============================================================================
; EXPLORATION MOVEMENT
; =============================================================================

to perform-exploration-step

  set state "exploring"

  right random-float 45
  left random-float 45

  let proposed-patch patch-ahead speed

  if proposed-patch != nobody [

    if [hazard-level] of proposed-patch > risk-tolerance [

      right (90 + random-float 180)
      set proposed-patch patch-ahead speed
    ]
  ]

  if proposed-patch != nobody [

    move-robot-step speed proposed-patch nobody
  ]

end


; =============================================================================
; CONTRACTED ROBOT BEHAVIOUR
; =============================================================================

to perform-contracted-step

  let current-target-id target-task-id

  let target-task
    one-of tasks with [task-id = current-target-id]

  ifelse target-task = nobody [

    clear-robot-contract

  ] [

    ifelse
      ([completed?] of target-task) or
      ([failed?] of target-task) or
      (not member? robot-id [assigned-robot-ids] of target-task)
    [

      clear-robot-contract

    ] [

      ifelse distance target-task <= task-arrival-radius [

        ifelse [cooperative?] of target-task [
          set state "waiting-for-coalition"
        ] [
          set state "waiting"
        ]

      ] [

        set state "travelling"
        face target-task

        let step-distance
          min (list speed distance target-task)

        if step-distance > 0 [

          let proposed-patch patch-ahead step-distance

          if proposed-patch != nobody [
            move-robot-step step-distance proposed-patch target-task
          ]
        ]
      ]
    ]
  ]

end


to move-robot-step [step-distance proposed-patch contracted-task]

  let local-terrain-cost
    [terrain-cost] of proposed-patch

  let local-hazard-level
    [hazard-level] of proposed-patch

  let movement-energy-cost
    (step-distance * movement-cost-rate * local-terrain-cost)

  let hazard-energy-cost
    (hazard-cost-rate * local-hazard-level)

  let total-step-cost
    (movement-energy-cost + hazard-energy-cost)

  ifelse energy >= total-step-cost [

    forward step-distance

    set distance-travelled
      (distance-travelled + step-distance)

    set energy
      (energy - total-step-cost)

    set energy-used
      (energy-used + total-step-cost)

    set strategy-period-payoff
      (strategy-period-payoff - total-step-cost)

    ask patch-here [
      set explored? true
    ]

  ] [

    set strategy-period-payoff
      (strategy-period-payoff - energy)

    set energy-used (energy-used + energy)
    set energy 0
    set state "depleted"

    if contracted-task != nobody [

      let reason-text
        ifelse-value [cooperative?] of contracted-task
          ["coalition-member-depleted"]
          ["contractor-depleted"]

      release-task-assignment contracted-task reason-text
    ]
  ]

end


to clear-robot-contract

  set target-task-id -1
  set current-bid 0
  set current-contribution 0

  if energy > 0 [
    set state "exploring"
  ]

end


; =============================================================================
; PARTIAL TASK DISCOVERY
; =============================================================================

to detect-nearby-tasks

  let detecting-robot self

  let effective-detection-radius
    (detection-radius * (0.50 + sensing-capability))

  let current-known-task-ids known-task-ids

  let candidate-tasks
    tasks in-radius effective-detection-radius with [
      not completed? and
      not failed? and
      not member? task-id current-known-task-ids
    ]

  if any? candidate-tasks [

    ask candidate-tasks [

      let local-visibility
        [visibility-level] of patch-here

      let detection-probability
        (bounded-value
          ([sensing-capability] of detecting-robot * local-visibility)
          0.05
          1)

      if random-float 1 < detection-probability [

        let detected-task-id task-id

        if not discovered? [

          set discovered? true
          set discovered-at ticks
          set discovered-by [robot-id] of detecting-robot
        ]

        ask detecting-robot [

          if not member? detected-task-id known-task-ids [

            set known-task-ids
              lput detected-task-id known-task-ids
          ]
        ]
      ]
    ]
  ]

end


; =============================================================================
; DYNAMIC COMMUNICATION NETWORK
; =============================================================================

to update-communication-network

  ask communication-links [
    die
  ]

  ask robots with [energy > 0] [

    let sender self
    let sender-id who

    let sender-environment-quality
      [communication-quality] of patch-here

    let sender-capability communication-capability

    let potential-partners
      other robots in-radius communication-radius with [
        energy > 0 and
        who > sender-id
      ]

    ask potential-partners [

      let receiver-environment-quality
        [communication-quality] of patch-here

      let environmental-quality
        ((sender-environment-quality + receiver-environment-quality) / 2)

      let capability-quality
        ((sender-capability + communication-capability) / 2)

      let effective-link-quality
        (environmental-quality * capability-quality)

      if
        (effective-link-quality >= communication-quality-threshold) and
        (random-float 1 >= communication-failure-rate)
      [

        create-communication-link-with sender [

          set link-quality effective-link-quality
          set thickness (0.05 + 0.20 * link-quality)

          ifelse show-network? [
            set color sky
            show-link
          ] [
            hide-link
          ]
        ]
      ]
    ]
  ]

end


; =============================================================================
; LOCAL INFORMATION SHARING
; =============================================================================

to share-task-information

  ask robots [
    set next-known-task-ids known-task-ids
  ]

  ask communication-links [

    let transmission-probability
      (information-sharing-probability * link-quality)

    if random-float 1 < transmission-probability [

      let knowledge-1 [known-task-ids] of end1
      let knowledge-2 [known-task-ids] of end2

      let new-for-1
        filter
          [task-value -> not member? task-value knowledge-1]
          knowledge-2

      let new-for-2
        filter
          [task-value -> not member? task-value knowledge-2]
          knowledge-1

      ask end1 [

        set next-known-task-ids
          remove-duplicates
            (sentence next-known-task-ids new-for-1)
      ]

      ask end2 [

        set next-known-task-ids
          remove-duplicates
            (sentence next-known-task-ids new-for-2)
      ]

      set information-transmissions
        (information-transmissions +
          length new-for-1 +
          length new-for-2)
    ]
  ]

  ask robots [

    let newly-acquired-items
      (length next-known-task-ids - length known-task-ids)

    set unique-information-acquisitions
      (unique-information-acquisitions + newly-acquired-items)

    set known-task-ids next-known-task-ids
  ]

end


; =============================================================================
; DECENTRALIZED TASK AUCTIONS
; =============================================================================

to run-decentralized-auctions

  ask tasks with [
    discovered? and
    not completed? and
    not failed? and
    empty? assigned-robot-ids
  ] [

    set auction-status "open"
    set bid-list []
    set winning-bid 0
  ]

  ask robots with [
    energy > 0 and
    target-task-id = -1
  ] [

    submit-best-bid
  ]

  resolve-task-auctions

end


to submit-best-bid

  set current-bid 0
  set current-contribution 0

  let candidate-task-ids
    filter
      [candidate-id ->
        any? tasks with [
          task-id = candidate-id and
          discovered? and
          not completed? and
          not failed? and
          empty? assigned-robot-ids
        ]
      ]
      known-task-ids

  let best-task-id -1
  let best-bid-value 0
  let best-contribution-value 0

  foreach candidate-task-ids [

    candidate-id ->

    let candidate-task
      one-of tasks with [
        task-id = candidate-id and
        not completed? and
        not failed? and
        empty? assigned-robot-ids
      ]

    if candidate-task != nobody [

      let candidate-bid
        bid-utility-for candidate-task

      if candidate-bid > best-bid-value [

        set best-task-id candidate-id
        set best-bid-value candidate-bid

        set best-contribution-value
          capability-contribution-for candidate-task
      ]
    ]
  ]

  if best-task-id != -1 [

    set current-bid best-bid-value
    set current-contribution best-contribution-value

    let submitting-robot-id robot-id
    let submitted-bid best-bid-value
    let submitted-contribution best-contribution-value

    ask one-of tasks with [task-id = best-task-id] [

      set bid-list
        lput
          (list
            submitting-robot-id
            submitted-bid
            submitted-contribution)
          bid-list

      set ever-received-bid? true
    ]
  ]

end


to resolve-task-auctions

  ask tasks with [
    auction-status = "open" and
    empty? assigned-robot-ids and
    length bid-list > 0
  ] [

    let number-of-bids length bid-list

    set total-bids
      (total-bids + number-of-bids)

    let available-positions required-team-size

    if number-of-bids > available-positions [

      set contested-auction-rounds
        (contested-auction-rounds + 1)
    ]

    ifelse cooperative? [

      set coalition-formation-attempts
        (coalition-formation-attempts + 1)

      resolve-cooperative-auction

    ] [

      resolve-individual-auction
    ]
  ]

end


to resolve-individual-auction

  let number-of-bids length bid-list

  let highest-bid
    max (map [bid-record -> item 1 bid-record] bid-list)

  let winning-records
    filter
      [bid-record -> item 1 bid-record = highest-bid]
      bid-list

  let winning-record
    item (random (length winning-records)) winning-records

  let winner-id item 0 winning-record

  award-task-to-robots
    (list winner-id)
    highest-bid

  register-auction-outcomes
    (list winner-id)
    number-of-bids

end


to resolve-cooperative-auction

  let number-of-bids length bid-list

  let ranked-records
    sort-by
      [[record-a record-b] ->
        ifelse-value
          (item 2 record-a = item 2 record-b)
          [item 1 record-a > item 1 record-b]
          [item 2 record-a > item 2 record-b]
      ]
      bid-list

  let selected-ids []
  let coalition-ready? false

  while [
    not coalition-ready? and
    not empty? ranked-records and
    length selected-ids < maximum-coalition-size
  ] [

    let next-record first ranked-records
    set ranked-records but-first ranked-records

    set selected-ids
      lput (item 0 next-record) selected-ids

    if length selected-ids >= required-team-size [

      set coalition-ready?
        coalition-meets-requirements?
          selected-ids
          self
    ]
  ]

  ifelse coalition-ready? [

    let selected-total-bid
      sum
        (map
          [bid-record ->
            ifelse-value
              (member? (item 0 bid-record) selected-ids)
              [item 1 bid-record]
              [0]
          ]
          bid-list)

    award-task-to-robots
      selected-ids
      selected-total-bid

    register-auction-outcomes
      selected-ids
      number-of-bids

    set coalitions-formed
      (coalitions-formed + 1)

  ] [

    set unresolved-auction-rounds
      (unresolved-auction-rounds + 1)

    set auction-status "open"
  ]

end


to award-task-to-robots [selected-ids aggregate-bid]

  let awarded-task-id task-id
  let cooperative-task? cooperative?

  set assigned-robot-ids
    remove-duplicates selected-ids

  set assigned-robot-id
    select-coalition-lead assigned-robot-ids self

  set winning-bid aggregate-bid
  set assignment-tick ticks
  set formation-delay
    max (list 0 (ticks - discovered-at))

  set auction-status "assigned"
  set ever-assigned? true
  set last-release-reason "none"
  set work-progress 0

  set total-contracts-awarded
    (total-contracts-awarded + 1)

  set total-contract-memberships-awarded
    (total-contract-memberships-awarded +
      length assigned-robot-ids)

  ask robots with [member? robot-id selected-ids] [

    set target-task-id awarded-task-id
    set state "travelling"

    set contracts-won
      (contracts-won + 1)

    if cooperative-task? [

      set cooperation-events
        (cooperation-events + 1)
    ]
  ]

end


to register-auction-outcomes [selected-ids number-of-bids]

  let bidder-id-list
    map [bid-record -> item 0 bid-record] bid-list

  let contested?
    (number-of-bids > required-team-size)

  ask robots with [member? robot-id bidder-id-list] [

    if contested? [

      set competition-events
        (competition-events + 1)
    ]

    if not member? robot-id selected-ids [

      set contracts-lost
        (contracts-lost + 1)

      set current-bid 0
      set current-contribution 0
    ]
  ]

end


; =============================================================================
; BID AND CAPABILITY REPORTERS
; =============================================================================

to-report bid-utility-for [candidate-task]

  if candidate-task = nobody [
    report -1
  ]

  let cooperative-task?
    [cooperative?] of candidate-task

  let capability-score
    capability-contribution-for candidate-task

  ifelse cooperative-task? [

    if capability-score < minimum-coalition-contribution [
      report -1
    ]

  ] [

    if capability-score < minimum-capability-fit [
      report -1
    ]
  ]

  let time-remaining
    ([deadline] of candidate-task - ticks)

  if time-remaining <= 0 [
    report -1
  ]

  let travel-distance distance candidate-task

  let travel-time
    (travel-distance / max (list speed 0.01))

  let service-time
    [service-duration] of candidate-task

  if (travel-time + service-time) > time-remaining [
    report -1
  ]

  let task-patch
    [patch-here] of candidate-task

  let task-terrain-cost
    [terrain-cost] of task-patch

  let task-hazard-level
    [hazard-level] of task-patch

  let task-risk
    [risk-level] of candidate-task

  let estimated-travel-energy
    ((travel-distance * movement-cost-rate * task-terrain-cost) +
      (travel-distance * hazard-cost-rate * task-hazard-level))

  let estimated-execution-energy
    (service-time * task-execution-cost-rate * (1 + task-risk))

  let estimated-total-energy
    (estimated-travel-energy + estimated-execution-energy)

  if estimated-total-energy > energy [
    report -1
  ]

  let expected-reward
    expected-reward-share-for candidate-task capability-score

  let risk-penalty
    ([base-reward] of candidate-task *
      risk-penalty-weight *
      task-risk *
      (1 - risk-tolerance))

  let deadline-pressure
    (bounded-value
      (1 - (time-remaining / mission-time-limit))
      0
      1)

  let urgency-bonus
    ([base-reward] of candidate-task *
      deadline-urgency-weight *
      deadline-pressure)

  let reputation-adjustment 0

  if reputation-enabled? [
    set reputation-adjustment
      ([base-reward] of candidate-task *
        reputation-weight *
        (reputation - 0.50))
  ]

  let strategy-adjustment
    strategy-utility-adjustment-for candidate-task

  let expected-utility
    (expected-reward +
      urgency-bonus +
      reputation-adjustment +
      strategy-adjustment -
      estimated-total-energy -
      risk-penalty)

  report expected-utility

end


to-report expected-reward-share-for [candidate-task contribution-score]

  let task-reward [base-reward] of candidate-task

  if not [cooperative?] of candidate-task [

    ifelse reward-regime = "mission-aligned" [
      report task-reward * (1 + mission-incentive-weight)
    ] [
      report task-reward
    ]
  ]

  let team-size
    [required-team-size] of candidate-task

  if reward-regime = "leader-priority" [

    ifelse robot-id = [discovered-by] of candidate-task [

      report task-reward * leader-reward-share

    ] [

      report
        (task-reward * (1 - leader-reward-share) /
          max (list 1 (team-size - 1)))
    ]
  ]

  if reward-regime = "equal-share" [
    report task-reward / team-size
  ]

  if reward-regime = "contribution-based" [

    let expected-total-contribution
      (contribution-score +
        ((team-size - 1) * 0.50))

    report
      task-reward *
      contribution-score /
      max (list 0.01 expected-total-contribution)
  ]

  if reward-regime = "mission-aligned" [

    let expected-base-share
      task-reward / team-size

    let expected-mission-bonus
      (task-reward * mission-incentive-weight / team-size)

    report expected-base-share + expected-mission-bonus
  ]

  report task-reward / team-size

end


to-report capability-contribution-for [candidate-task]

  let sensing-contribution
    min
      (list
        1
        (sensing-capability /
          max (list 0.01 [required-sensing] of candidate-task)))

  let manipulation-contribution
    min
      (list
        1
        (manipulation-capability /
          max (list 0.01 [required-manipulation] of candidate-task)))

  let transport-contribution
    min
      (list
        1
        (transport-capability /
          max (list 0.01 [required-transport] of candidate-task)))

  let communication-contribution
    min
      (list
        1
        (communication-capability /
          max (list 0.01 [required-communication] of candidate-task)))

  report
    mean
      (list
        sensing-contribution
        manipulation-contribution
        transport-contribution
        communication-contribution)

end


to-report coalition-meets-requirements? [member-ids candidate-task]

  let coalition-members
    robots with [member? robot-id member-ids]

  if count coalition-members < [required-team-size] of candidate-task [
    report false
  ]

  report
    (sum [sensing-capability] of coalition-members >=
      [required-sensing] of candidate-task) and
    (sum [manipulation-capability] of coalition-members >=
      [required-manipulation] of candidate-task) and
    (sum [transport-capability] of coalition-members >=
      [required-transport] of candidate-task) and
    (sum [communication-capability] of coalition-members >=
      [required-communication] of candidate-task)

end


to-report select-coalition-lead [member-ids candidate-task]

  if member? [discovered-by] of candidate-task member-ids [
    report [discovered-by] of candidate-task
  ]

  let coalition-members
    robots with [member? robot-id member-ids]

  if not any? coalition-members [
    report -1
  ]

  let lead-robot
    max-one-of coalition-members
      [(capability-contribution-for candidate-task) +
        (ifelse-value reputation-enabled?
          [reputation-weight * reputation]
          [0])]

  report [robot-id] of lead-robot

end


; =============================================================================
; CONTRACT EXECUTION AND COALITION SYNCHRONIZATION
; =============================================================================

to advance-active-tasks

  ask tasks with [
    not completed? and
    not failed? and
    not empty? assigned-robot-ids
  ] [

    let current-task self
    let current-task-id task-id
    let expected-member-ids assigned-robot-ids

    let assigned-members
      robots with [
        member? robot-id expected-member-ids and
        target-task-id = current-task-id and
        energy > 0
      ]

    ifelse count assigned-members < length expected-member-ids [

      let reason-text
        ifelse-value cooperative?
          ["coalition-member-unavailable"]
          ["contractor-unavailable"]

      release-task-assignment current-task reason-text

    ] [

      let arrived-members
        assigned-members with [
          distance current-task <= task-arrival-radius
        ]

      ifelse count arrived-members = length expected-member-ids [

        if execution-start-tick = -1 [
          set execution-start-tick ticks
        ]

        execute-active-task current-task assigned-members

      ] [

        set total-waiting-ticks
          (total-waiting-ticks + count arrived-members)

        ask arrived-members [

          ifelse [cooperative?] of current-task [
            set state "waiting-for-coalition"
          ] [
            set state "waiting"
          ]
        ]

        if ticks - assignment-tick >= coalition-wait-limit [

          let timeout-reason
            ifelse-value cooperative?
              ["coalition-arrival-timeout"]
              ["contract-arrival-timeout"]

          release-task-assignment current-task timeout-reason
        ]
      ]
    ]
  ]

end


to execute-active-task [current-task assigned-members]

  let execution-energy-cost
    (task-execution-cost-rate *
      (1 + [risk-level] of current-task))

  ifelse all? assigned-members [energy >= execution-energy-cost] [

    ask assigned-members [

      set state "executing"

      set energy
        (energy - execution-energy-cost)

      set energy-used
        (energy-used + execution-energy-cost)

      set strategy-period-payoff
        (strategy-period-payoff - execution-energy-cost)
    ]

    ask current-task [

      set work-progress
        (work-progress + 1)

      if work-progress >= service-duration [
        complete-current-task
      ]
    ]

  ] [

    ask assigned-members with [energy < execution-energy-cost] [

      set strategy-period-payoff
        (strategy-period-payoff - energy)

      set energy-used (energy-used + energy)
      set energy 0
      set state "depleted"
    ]

    let reason-text
      ifelse-value [cooperative?] of current-task
        ["coalition-member-depleted"]
        ["contractor-depleted"]

    release-task-assignment current-task reason-text
  ]

end


to complete-current-task

  let current-task self
  let current-task-id task-id
  let member-ids assigned-robot-ids

  let payout-records
    reward-payout-records-for member-ids current-task

  let distributed-total 0

  foreach payout-records [

    payout-record ->

    let recipient-id item 0 payout-record
    let payment item 1 payout-record

    set distributed-total
      (distributed-total + payment)

    ask robots with [robot-id = recipient-id] [

      set credits (credits + payment)
      set last-payoff payment
      set strategy-period-payoff
        (strategy-period-payoff + payment)

      set contract-successes
        (contract-successes + 1)

      update-reputation-after-success

      set tasks-completed
        (tasks-completed + 1)

      set target-task-id -1
      set current-bid 0
      set current-contribution 0

      if energy > 0 [
        set state "exploring"
      ]
    ]
  ]

  set total-task-value
    (total-task-value + base-reward)

  set total-rewards-distributed
    (total-rewards-distributed + distributed-total)

  if reward-regime = "mission-aligned" [

    set total-mission-bonuses
      (total-mission-bonuses +
        max (list 0 (distributed-total - base-reward)))
  ]

  if cooperative? [

    set coalition-tasks-completed
      (coalition-tasks-completed + 1)
  ]

  set completed? true
  set completed-at ticks
  set completed-by-robot-ids member-ids
  set distributed-reward distributed-total
  set failed? false

  set failure-reason "none"
  set auction-status "completed"

  set assigned-robot-id -1
  set assigned-robot-ids []
  set winning-bid 0

  set hidden? false

end


to-report reward-payout-records-for [member-ids candidate-task]

  let payout-records []
  let member-count length member-ids
  let task-reward [base-reward] of candidate-task

  if member-count = 0 [
    report payout-records
  ]

  if not [cooperative?] of candidate-task [

    let recipient-id first member-ids

    let payment
      ifelse-value reward-regime = "mission-aligned"
        [task-reward * (1 + mission-incentive-weight)]
        [task-reward]

    report (list (list recipient-id payment))
  ]

  if reward-regime = "leader-priority" [

    let lead-id [assigned-robot-id] of candidate-task
    let leader-payment task-reward * leader-reward-share
    let supporter-total task-reward - leader-payment
    let supporter-count max (list 1 (member-count - 1))

    foreach member-ids [

      member-id ->

      let payment
        ifelse-value member-id = lead-id
          [leader-payment]
          [supporter-total / supporter-count]

      set payout-records
        lput (list member-id payment) payout-records
    ]

    report payout-records
  ]

  if reward-regime = "equal-share" [

    let equal-payment task-reward / member-count

    foreach member-ids [
      member-id ->
      set payout-records
        lput (list member-id equal-payment) payout-records
    ]

    report payout-records
  ]

  if reward-regime = "contribution-based" [

    let contribution-records []
    let total-contribution 0

    foreach member-ids [

      member-id ->

      let member-robot
        one-of robots with [robot-id = member-id]

      let contribution
        ifelse-value member-robot = nobody
          [0]
          [[capability-contribution-for candidate-task] of member-robot]

      set contribution-records
        lput (list member-id contribution) contribution-records

      set total-contribution
        (total-contribution + contribution)
    ]

    foreach contribution-records [

      contribution-record ->

      let member-id item 0 contribution-record
      let contribution item 1 contribution-record

      let payment
        task-reward *
        contribution /
        max (list 0.01 total-contribution)

      set payout-records
        lput (list member-id payment) payout-records
    ]

    report payout-records
  ]

  if reward-regime = "mission-aligned" [

    let base-payment task-reward / member-count
    let total-bonus task-reward * mission-incentive-weight
    let bonus-payment total-bonus / member-count

    foreach member-ids [
      member-id ->
      set payout-records
        lput
          (list member-id (base-payment + bonus-payment))
          payout-records
    ]

    report payout-records
  ]

  ; Defensive fallback.
  let fallback-payment task-reward / member-count

  foreach member-ids [
    member-id ->
    set payout-records
      lput (list member-id fallback-payment) payout-records
  ]

  report payout-records

end


; =============================================================================
; CONTRACT RELEASE AND FAILURE TRACEABILITY
; =============================================================================

to release-task-assignment [target-task reason-text]

  if target-task = nobody [
    stop
  ]

  let target-task-id-value
    [task-id] of target-task

  let released-member-ids
    [assigned-robot-ids] of target-task

  let cooperative-task?
    [cooperative?] of target-task

  ask robots with [member? robot-id released-member-ids] [

    if target-task-id = target-task-id-value [

      set contract-failures
        (contract-failures + 1)

      set contract-release-events
        (contract-release-events + 1)

      update-reputation-after-failure

      set target-task-id -1
      set current-bid 0
      set current-contribution 0
      set last-payoff 0

      if energy > 0 [
        set state "exploring"
      ]
    ]
  ]

  ask target-task [

    set assigned-robot-id -1
    set assigned-robot-ids []
    set winning-bid 0
    set assignment-tick -1

    set auction-status "open"
    set work-progress 0

    set last-release-reason reason-text
    set release-count (release-count + 1)
  ]

  set total-contract-releases
    (total-contract-releases + 1)

  if cooperative-task? [

    set coalition-release-events
      (coalition-release-events + 1)
  ]

end


to update-task-deadlines

  ask tasks with [
    not completed? and
    not failed? and
    ticks >= deadline
  ] [

    let expired-task self
    let expired-task-id task-id
    let contracted-member-ids assigned-robot-ids

    ifelse not discovered? [

      set failure-reason "undiscovered"

    ] [

      ifelse not empty? assigned-robot-ids [

        ifelse cooperative? [
          set failure-reason "coalition-deadline-after-assignment"
        ] [
          set failure-reason "deadline-after-assignment"
        ]

      ] [

        ifelse ever-assigned? [

          ifelse last-release-reason != "none" [
            set failure-reason last-release-reason
          ] [
            set failure-reason "contract-released-before-deadline"
          ]

        ] [

          ifelse ever-received-bid? [

            ifelse cooperative? [
              set failure-reason "no-feasible-coalition"
            ] [
              set failure-reason "auction-unresolved"
            ]

          ] [

            set failure-reason "no-feasible-bid"
          ]
        ]
      ]
    ]

    if not empty? contracted-member-ids [
      ask robots with [member? robot-id contracted-member-ids] [
        set contract-failures
          (contract-failures + 1)
        update-reputation-after-failure
      ]
    ]

    set failed? true
    set auction-status "failed"

    set assigned-robot-id -1
    set assigned-robot-ids []
    set winning-bid 0
    set assignment-tick -1

    ask robots with [member? robot-id contracted-member-ids] [

      if target-task-id = expired-task-id [

        set target-task-id -1
        set current-bid 0
        set current-contribution 0
        set last-payoff 0

        if energy > 0 [
          set state "exploring"
        ]
      ]
    ]
  ]

end


; =============================================================================
; REPUTATION AND CONTRACT RELIABILITY
; =============================================================================

to update-reputation-after-success

  if reputation-enabled? [
    set reputation
      (bounded-value
        (reputation +
          reputation-learning-rate *
          completion-reputation-reward *
          (1 - reputation))
        0
        1)
  ]

end


to update-reputation-after-failure

  if reputation-enabled? [
    set reputation
      (bounded-value
        (reputation -
          reputation-learning-rate *
          contract-failure-reputation-penalty *
          max (list 0.10 reputation))
        0
        1)
  ]

end


to update-reputation-decay

  if reputation-enabled? [
    ask robots [
      set reputation
        (bounded-value
          (reputation +
            reputation-decay-rate *
            (0.50 - reputation))
          0
          1)
    ]
  ]

end


; =============================================================================
; ADAPTIVE STRATEGY SELECTION
; =============================================================================

to initialize-robot-strategy

  set competitive-value 0
  set cooperative-value 0
  set balanced-value 0
  set strategy-period-payoff 0
  set strategy-switches 0
  set last-strategy-update 0

  ifelse initial-strategy = "mixed" [
    let initial-options
      (list "competitive" "cooperative" "balanced")

    set strategy
      item (random (length initial-options)) initial-options
  ] [
    set strategy initial-strategy
  ]

end


to update-adaptive-strategies

  if adaptive-strategies? and
     ticks > 0 and
     ticks mod strategy-update-interval = 0
  [
    ask robots [

      update-current-strategy-value

      let old-strategy strategy
      let next-strategy select-next-strategy

      set strategy next-strategy

      if strategy != old-strategy [
        set strategy-switches
          (strategy-switches + 1)

        set strategy-switches-total
          (strategy-switches-total + 1)
      ]

      set strategy-period-payoff 0
      set last-strategy-update ticks
    ]
  ]

end


to update-current-strategy-value

  if strategy = "competitive" [
    set competitive-value
      (competitive-value +
        strategy-learning-rate *
        (strategy-period-payoff - competitive-value))
  ]

  if strategy = "cooperative" [
    set cooperative-value
      (cooperative-value +
        strategy-learning-rate *
        (strategy-period-payoff - cooperative-value))
  ]

  if strategy = "balanced" [
    set balanced-value
      (balanced-value +
        strategy-learning-rate *
        (strategy-period-payoff - balanced-value))
  ]

end


to-report select-next-strategy

  let available-strategies
    (list "competitive" "cooperative" "balanced")

  if random-float 1 < strategy-exploration-rate [
    report item (random (length available-strategies)) available-strategies
  ]

  let maximum-value
    max (list competitive-value cooperative-value balanced-value)

  let best-strategies []

  if competitive-value = maximum-value [
    set best-strategies
      lput "competitive" best-strategies
  ]

  if cooperative-value = maximum-value [
    set best-strategies
      lput "cooperative" best-strategies
  ]

  if balanced-value = maximum-value [
    set best-strategies
      lput "balanced" best-strategies
  ]

  report item (random (length best-strategies)) best-strategies

end


to-report strategy-utility-adjustment-for [candidate-task]

  let task-reward [base-reward] of candidate-task
  let cooperative-task? [cooperative?] of candidate-task

  if strategy = "competitive" [
    report
      ifelse-value cooperative-task?
        [-0.10 * task-reward]
        [0.08 * task-reward]
  ]

  if strategy = "cooperative" [
    report
      ifelse-value cooperative-task?
        [0.15 * task-reward]
        [-0.02 * task-reward]
  ]

  report 0

end


; =============================================================================
; ADVANCED COMPLEX-SYSTEMS METRICS
; =============================================================================

to-report completion-rate

  if not any? tasks [
    report 0
  ]

  report
    100 * count tasks with [completed?] / count tasks

end


to-report discovered-task-completion-rate

  let discovered-count count tasks with [discovered?]

  if discovered-count = 0 [
    report 0
  ]

  report
    100 * count tasks with [completed?] / discovered-count

end


to-report explored-area-percentage

  report
    100 * count patches with [explored?] / count patches

end


to-report mean-network-degree

  if not any? robots [
    report 0
  ]

  report
    mean [count my-communication-links] of robots

end


to-report current-network-density

  if count robots < 2 [
    report 0
  ]

  report
    (2 * count communication-links) /
    (count robots * (count robots - 1))

end


to-report information-coverage

  if (not any? robots) or (not any? tasks) [
    report 0
  ]

  report
    100 * sum [length known-task-ids] of robots /
    (count robots * count tasks)

end


to-report information-redundancy-ratio

  if information-transmissions = 0 [
    report 0
  ]

  report
    max
      (list 0
        ((information-transmissions -
          unique-information-acquisitions) /
          information-transmissions))

end


to-report coalition-success-rate

  if coalitions-formed = 0 [
    report 0
  ]

  report
    100 * coalition-tasks-completed / coalitions-formed

end


to-report mean-coalition-size

  let completed-cooperative-tasks
    tasks with [cooperative? and completed?]

  if not any? completed-cooperative-tasks [
    report 0
  ]

  report
    mean [length completed-by-robot-ids]
      of completed-cooperative-tasks

end


to-report mean-coalition-formation-delay

  let formed-coalition-tasks
    tasks with [cooperative? and ever-assigned? and formation-delay >= 0]

  if not any? formed-coalition-tasks [
    report 0
  ]

  report mean [formation-delay] of formed-coalition-tasks

end


to-report mean-reputation

  if not any? robots [
    report 0
  ]

  report mean [reputation] of robots

end


to-report reputation-inequality

  report gini-of-list ([reputation] of robots)

end


to-report reward-gini

  report gini-of-list ([credits] of robots)

end


to-report contract-gini

  report gini-of-list ([contracts-won] of robots)

end


to-report top-reward-share

  if not any? robots [
    report 0
  ]

  let total-credits sum [credits] of robots

  if total-credits <= 0 [
    report 0
  ]

  let sorted-credits
    sort-by [[a b] -> a > b] [credits] of robots

  let top-count
    max (list 1 ceiling (0.20 * length sorted-credits))

  report
    100 * sum (sublist sorted-credits 0 top-count) /
    total-credits

end


to-report coordination-overhead

  let completed-count count tasks with [completed?]

  if completed-count = 0 [
    report
      (total-bids +
        information-transmissions +
        coalition-formation-attempts +
        total-contract-releases)
  ]

  report
    (total-bids +
      information-transmissions +
      coalition-formation-attempts +
      total-contract-releases) /
    completed-count

end


to-report coalition-efficiency

  if coalition-formation-attempts = 0 [
    report 0
  ]

  report
    100 * coalitions-formed /
    coalition-formation-attempts

end


to-report mission-coordination-efficiency

  let resource-cost
    (sum [energy-used] of robots +
      total-bids +
      unique-information-acquisitions +
      coalition-formation-attempts +
      total-contract-releases)

  if resource-cost <= 0 [
    report 0
  ]

  report total-task-value / resource-cost

end


to-report mean-competitive-value

  if not any? robots [report 0]
  report mean [competitive-value] of robots

end


to-report mean-cooperative-value

  if not any? robots [report 0]
  report mean [cooperative-value] of robots

end


to-report mean-balanced-value

  if not any? robots [report 0]
  report mean [balanced-value] of robots

end


to-report gini-of-list [raw-values]

  let values sort raw-values
  let item-count length values

  if item-count = 0 [
    report 0
  ]

  let value-total sum values

  if value-total = 0 [
    report 0
  ]

  let weighted-total 0
  let index 1

  foreach values [
    value ->
    set weighted-total
      (weighted-total + index * value)
    set index (index + 1)
  ]

  report
    ((2 * weighted-total) /
      (item-count * value-total)) -
    ((item-count + 1) / item-count)

end


; =============================================================================
; AUTOMATED VERIFICATION
; =============================================================================

to run-verification-checks

  let task-state-check
    all? tasks [not (completed? and failed?)]

  let robot-contract-check
    all? robots [
      target-task-id = -1 or
      any? tasks with [
        task-id = [target-task-id] of myself and
        member? [robot-id] of myself assigned-robot-ids
      ]
    ]

  let energy-accounting-check
    (abs
      ((sum [starting-energy] of robots) -
        (sum [energy-used] of robots) -
        (sum [energy] of robots))) < 0.000001

  let reward-accounting-check
    (abs
      ((sum [credits] of robots) -
        total-rewards-distributed)) < 0.000001

  let coalition-membership-check
    all? tasks with [not empty? assigned-robot-ids] [
      empty? filter
        [member-id ->
          not any? robots with [
            robot-id = member-id and
            target-task-id = [task-id] of myself
          ]]
        assigned-robot-ids
    ]

  let failure-traceability-check
    all? tasks with [failed?] [failure-reason != "none"]

  let knowledge-integrity-check
    all? robots [
      empty? filter
        [task-value ->
          not any? tasks with [task-id = task-value]]
        known-task-ids
    ]

  let reputation-bounds-check
    all? robots [reputation >= 0 and reputation <= 1]

  let strategy-validity-check
    all? robots [
      member? strategy
        (list "competitive" "cooperative" "balanced")
    ]

  print ""
  print "MOSAIC AUTOMATED VERIFICATION"
  print "----------------------------------------"
  print (word "TASK STATE CONSISTENCY: " pass-label task-state-check)
  print (word "CONTRACT CONSISTENCY: " pass-label robot-contract-check)
  print (word "ENERGY ACCOUNTING: " pass-label energy-accounting-check)
  print (word "REWARD ACCOUNTING: " pass-label reward-accounting-check)
  print (word "COALITION MEMBERSHIP: " pass-label coalition-membership-check)
  print (word "FAILURE TRACEABILITY: " pass-label failure-traceability-check)
  print (word "KNOWLEDGE INTEGRITY: " pass-label knowledge-integrity-check)
  print (word "REPUTATION BOUNDS: " pass-label reputation-bounds-check)
  print (word "STRATEGY VALIDITY: " pass-label strategy-validity-check)

  let all-checks-pass?
    task-state-check and
    robot-contract-check and
    energy-accounting-check and
    reward-accounting-check and
    coalition-membership-check and
    failure-traceability-check and
    knowledge-integrity-check and
    reputation-bounds-check and
    strategy-validity-check

  set verification-last-result
    ifelse-value all-checks-pass? ["PASS"] ["FAIL"]

  print "----------------------------------------"
  print (word "OVERALL RESULT: " verification-last-result)

end


to-report pass-label [check-result]

  report ifelse-value check-result ["PASS"] ["FAIL"]

end


; =============================================================================
; VISUALIZATION
; =============================================================================

to update-robot-appearance

  ask robots [

    ifelse state = "depleted" [

      set color gray

    ] [

      ifelse state = "executing" [

        set color violet

      ] [

        ifelse state = "waiting-for-coalition" [

          set color magenta

        ] [

          ifelse state = "waiting" [

            set color yellow

          ] [

            ifelse state = "travelling" [

              set color orange

            ] [

              set color
                (scale-color blue energy 0 starting-energy)
            ]
          ]
        ]
      ]
    ]

    ifelse show-robot-labels? [
      set label (word "R" robot-id)
    ] [
      set label ""
    ]
  ]

end


to update-task-appearance

  ask tasks [

    ifelse completed? [

      set hidden? false
      set color green

      ifelse show-task-labels? [
        set label (word "T" task-id)
      ] [
        set label ""
      ]

    ] [

      ifelse failed? [

        ifelse discovered? [

          set hidden? false
          set color red

          ifelse show-task-labels? [
            set label (word "X" task-id)
          ] [
            set label ""
          ]

        ] [

          set hidden? true
          set label ""
        ]

      ] [

        ifelse discovered? [

          set hidden? false

          ifelse not empty? assigned-robot-ids [

            ifelse cooperative? [
              set color magenta
              ifelse show-task-labels? [
                set label (word "C" task-id)
              ] [
                set label ""
              ]
            ] [
              set color orange
              ifelse show-task-labels? [
                set label (word "A" task-id)
              ] [
                set label ""
              ]
            ]

          ] [

            ifelse cooperative? [
              set color violet
              ifelse show-task-labels? [
                set label (word "M" task-id)
              ] [
                set label ""
              ]
            ] [
              set color yellow
              ifelse show-task-labels? [
                set label (word "T" task-id)
              ] [
                set label ""
              ]
            ]
          ]

        ] [

          set hidden? true
          set label ""
        ]
      ]
    ]
  ]

end

; =============================================================================
; GENERAL REPORTERS
; =============================================================================

to-report bounded-value [input-value minimum-value maximum-value]

  report
    max
      (list
        minimum-value
        (min
          (list maximum-value input-value)))

end
